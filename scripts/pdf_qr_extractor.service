[Unit]
Description=PDF QR Extractor Service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=pdfqr
Group=pdfqr
ExecStart=/opt/pdf-qr-extractor/bin/pdf_qr_extractor /opt/pdf-qr-extractor/config/pdf_qr_extractor.conf

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pdf-qr-extractor/run /opt/pdf-qr-extractor/logs

[Install]
WantedBy=multi-user.target

